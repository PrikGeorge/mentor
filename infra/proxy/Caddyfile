{
	admin off
}

{$MENTOR_SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	# HSTS only makes sense (and is only honoured by browsers) on TLS responses: in local HTTP mode nothing is
	# sent, in production the header goes out on every response, API included. Override the value with
	# MENTOR_HSTS (e.g. a short max-age for a first rollout, or "max-age=0" to withdraw it).
	@https protocol https
	header @https Strict-Transport-Security "{$MENTOR_HSTS:max-age=31536000; includeSubDomains}"

	# Legacy source/download URLs and backend management paths must never fall through to the Angular shell.
	# Actuator is reachable only inside the container network (compose healthcheck), never through this edge.
	@private path_regexp private (?i)^/(internal|actuator|private|data|content|code|training|downloads|lib|src|backend|runner|infra|contracts|node_modules|\.git|\.runtime|\.superpowers)(/|$)|^/api/(materials|downloads)(/|$)
	handle @private {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy {$MENTOR_BACKEND_UPSTREAM:backend:8081} {
			header_up Host {http.request.hostport}
			header_up -Forwarded
			header_up -X-Forwarded-Host
			# The dedicated header is trusted only from this edge's exact private IP.
			header_up X-Mentor-Client-IP {http.request.remote.host}
			header_up X-Mentor-Client-Proto {http.request.scheme}
		}
	}

	handle /api/* {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	handle {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}

# Internal readiness listener for the Compose healthcheck: plain HTTP on the container loopback only,
# never published, unaffected by the production HTTP->HTTPS redirect of the site above.
http://127.0.0.1:8080 {
	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}
	handle {
		respond "Not found" 404
	}
}
