# Build context is the repository root. The Angular sources, the lockfile and a prebuilt dist are visible;
# node_modules, caches and test output stay out; infra/ permits only the proxy config and Caddy build inputs.
**
!frontend/
frontend/node_modules/
frontend/tools/api/node_modules/
frontend/.angular/
frontend/test-results/
frontend/playwright-report/
frontend/dist/**
!frontend/dist/mentor/
frontend/dist/mentor/**
!frontend/dist/mentor/browser/
!frontend/dist/mentor/browser/**
!frontend/dist/mentor/3rdpartylicenses.txt
!infra/
infra/**
!infra/proxy/
infra/proxy/**
!infra/proxy/Caddyfile
!infra/caddy/
infra/caddy/**
!infra/caddy/go.mod
!infra/caddy/go.sum
!infra/caddy/main.go
