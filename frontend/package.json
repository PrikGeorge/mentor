{
  "name": "mentor-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "tools/api"
  ],
  "scripts": {
    "start": "ng serve --port 4201 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test",
    "test:ui": "node tools/playwright.mjs",
    "e2e": "node tools/browser-fixture.mjs",
    "e2e:practice": "node tools/playwright.mjs --config playwright.practice.config.ts",
    "api:generate": "npm run generate --workspace @mentor/api-types",
    "api:check": "npm run api:generate && git diff --exit-code -- src/app/api/schema.d.ts"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/old-standard-tt": "5.3.0",
    "@fontsource/pt-mono": "5.3.0",
    "markdown-it": "15.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
